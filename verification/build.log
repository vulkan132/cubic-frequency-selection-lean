info: GMZP0/Audit.lean:620:0: GMZP0.uniform_original_real_lift (κ η : ℝ) (hκ : 0 < κ) (hη : 0 < η) (hη1 : η ≤ 1) :
  ∃ M c a d E N₀,
    0 < M ∧
      0 < c ∧
        0 < a ∧
          0 < d ∧
            0 < E ∧
              0 < N₀ ∧
                ∀ (N : ℕ),
                  N₀ ≤ N →
                    ∀ (q : ℕ) [inst : Fact (Nat.Prime q)],
                      N ^ 2 < q →
                        q ≤ 128 * N ^ 2 →
                          ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ)
                            (μ : GMZP0.Base N → ℝ),
                            GMZP0.Admissible N κ η f θ lam μ →
                              ∃ X D b F,
                                D = X ×ˢ GMZP0.safeRows N (N / M) ∧
                                  (∀ (x : Fin N), x ∈ X ↔ b ≤ ↑x ∧ ↑x ≤ b + N / M) ∧
                                    c ≤ ∑ z ∈ D, μ z ∧
                                      (∀ x ∈ X, ∀ x' ∈ X, |↑↑x' - ↑↑x| ≤ ↑(N / M)) ∧
                                        (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                          η * ∑ z ∈ D, μ z ≤
                                              ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D)
                                                  lam‖ ∧
                                            9 ≤ GMZP0.liftGridSize N E ∧
                                              (∀ (x : Fin N) (Y : ZMod q),
                                                  ∃ k, F x Y = ↑k / ↑(GMZP0.liftGridSize N E)) ∧
                                                (∀ (x : Fin N) (Y : ZMod q), |F x Y| ≤ 3) ∧
                                                  (∀ (x : Fin N) (Y : ZMod q),
                                                      GMZP0.cyclicField N q (GMZP0.originalScaledWeight N μ D) 0 x Y =
                                                          0 →
                                                        F x Y = 0) ∧
                                                    (∀ (x : Fin N) (Y : ZMod q),
                                                        0 <
                                                            GMZP0.cyclicField N q (GMZP0.originalScaledWeight N μ D) 0 x
                                                              Y →
                                                          ‖↑(F x Y) - d • GMZP0.cyclicField N q θ 0 x Y‖ ≤
                                                            19 * E / ↑N ^ 3) ∧
                                                      (a / 4) ^ 16 / (4 * 57 ^ 16) ≤
                                                          GMZP0.cyclicRealCubeMass N q (GMZP0.smoothingRadius N a)
                                                            (GMZP0.originalScaledWeight N μ D) F ∧
                                                        ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
