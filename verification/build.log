  (hM0 : ∀ (k : ℤ), 0 ≤ M k)
  (hM : ∀ (y : Fin (N ^ 2)), ∀ k ∈ Finset.Icc (-↑N) ↑N, k ≠ 0 → ‖GMZP0.wideLagSum P x x' (↑(GMZP0.label y)) k‖ ≤ M k)
