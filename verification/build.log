info: GMZP0/Audit.lean:1070:0: GMZP0.UniformOrdinaryFreezing (D : ℕ) : Prop
info: GMZP0/Audit.lean:1071:0: GMZP0.uniform_ordinary_block_row_relation (hW : GMZP0.PolynomialLeadingWeylInput) (D : ℕ) (hD : 2 ≤ D) (v : ℝ)
  (hv : 0 < v) :
  ∃ Q E N₀,
    0 < Q ∧
      0 < E ∧
        0 < N₀ ∧
          ∀ (N : ℕ),
            N₀ ≤ N →
              ∀ (P : Fin N → Polynomial ℝ),
                (∀ (x : Fin N), (P x).natDegree ≤ D) →
                  ∀ (m : GMZP0.Base N → ℂ),
                    (∀ (z : GMZP0.Base N), ‖m z‖ ≤ 1) →
                      ∀ (x x' : Fin N),
                        x ≠ x' →
                          ¬GMZP0.KernelEnergyBound
                                (GMZP0.blockGramKernel
                                  (GMZP0.outputMaskedKernel (GMZP0.responseKernel N (GMZP0.ordinaryOriginalProfile P))
                                    m)
                                  x x')
                                (v / ↑N) →
                            ∃ n,
                              0 < n ∧ n ≤ Q ∧ ‖n • GMZP0.horizontalGap x x' ^ D • ↑((P x).coeff D)‖ ≤ E / ↑N ^ (D + 3)
