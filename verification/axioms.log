            ∀ (N : ℕ),
              N₀ ≤ N →
                ∀ (J : ℕ),
                  0 < J →
                    ∀ (Q : ℕ) (Qchild : Fin J → ℕ),
                      (∀ (i : Fin J), 2 * Qchild i ≤ Q) →
                        ∀ (p : GMZP0.Base N → GMZP0.Frequency) (child : Fin J → GMZP0.Base N → GMZP0.Frequency)
                          (j : GMZP0.Base N → Fin J) (A : Finset (GMZP0.Base N)),
                          (∀ z ∉ A,
                              ¬GMZP0.MajorArc Q N (p z) → ‖p z - child (j z) z‖ ≤ s / 12 / (2 * Real.pi * ↑N ^ 3)) →
                            (∀ (x : Fin N),
                                ↑(GMZP0.largeBlockNeighbors
                                        (GMZP0.outputMaskedKernel (GMZP0.responseKernel N p)
                                          (GMZP0.restrictOutputMask (GMZP0.minorOutputMask Q N p) A))
                                        Finset.univ v x).card ≤
                                  ρ * ↑N) →
                              (∀ (i : Fin J), GMZP0.FiniteMinorEstimate (Qchild i) N (s / (3 * √↑J)) (child i)) →
                                GMZP0.FiniteMinorEstimate Q N s p
