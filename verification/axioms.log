                                    ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.finite_to_cyclic_modulus_average {N q : ℕ} [NeZero q] (hN : 0 < N) (hq : N ^ 2 < q) (H : ℕ)
  (p : GMZP0.Base N → GMZP0.Frequency) (X : Finset (Fin N)) (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ)
  (hHN : H ≤ N) (hX : ∀ x ∈ X, ∀ x' ∈ X, |GMZP0.horizontalGap x x'| ≤ ↑H)
  (hsafe : ∀ (x : Fin N) (y : Fin (N ^ 2)), σ (x, y) ≠ 0 → GMZP0.SafeVertical (↑N) (↑H) (↑↑y + 1)) :
  GMZP0.finiteRerootedNormAverage N p X σ lam = 2 * ↑q / ↑N ^ 2 * GMZP0.cyclicModulusAverage N q p X σ lam
GMZP0.uniform_positive_cyclic_average (κ η : ℝ) (hκ : 0 < κ) (hη : 0 < η) (hη1 : η ≤ 1) :
  ∃ M c ζ N₀,
    0 < M ∧
      0 < c ∧
        0 < ζ ∧
          0 < N₀ ∧
            ∀ (N : ℕ),
              N₀ ≤ N →
                ∀ (q : ℕ) [inst : NeZero q],
                  N ^ 2 < q →
                    q ≤ 128 * N ^ 2 →
                      ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ)
                        (μ : GMZP0.Base N → ℝ),
                        GMZP0.Admissible N κ η f θ lam μ →
                          ∃ X D a,
                            D = X ×ˢ GMZP0.safeRows N (N / M) ∧
                              (∀ (x : Fin N), x ∈ X ↔ a ≤ ↑x ∧ ↑x ≤ a + N / M) ∧
                                c ≤ ∑ z ∈ D, μ z ∧
                                  (∀ x ∈ X, ∀ x' ∈ X, |↑↑x' - ↑↑x| ≤ ↑(N / M)) ∧
                                    (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                      η * ∑ z ∈ D, μ z ≤
                                          ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D)
                                              lam‖ ∧
                                        ζ / 128 ≤
                                            GMZP0.cyclicModulusAverage N q θ X (GMZP0.originalScaledWeight N μ D) lam ∧
                                          ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.cyclicModulusAverage_as_uniform_mean (N q : ℕ) [NeZero q] (p : GMZP0.Base N → GMZP0.Frequency)
  (X : Finset (Fin N)) (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) :
  GMZP0.cyclicModulusAverage N q p X σ lam =
    (∑ z,
        GMZP0.cyclicWeight N q σ X z * ‖GMZP0.cyclicShiftLagB N q p σ lam z.1 z.2.2.1 ↑z.2.1 ↑(GMZP0.label z.2.2.2)‖) /
      ↑(Fintype.card (GMZP0.CyclicSamplingSpace N q))
GMZP0.exists_prime_cyclic_modulus {N : ℕ} (hN : 0 < N) : ∃ q, Nat.Prime q ∧ 64 * N ^ 2 < q ∧ q < 128 * N ^ 2
GMZP0.norm_Icc_translate (a b d : ℤ) (f : ℤ → ℂ) (hf : ∀ (k : ℤ), ‖f k‖ ≤ 1) :
  ‖∑ k ∈ Finset.Icc a b, f (k + d) - ∑ k ∈ Finset.Icc a b, f k‖ ≤ 2 * |↑d|
GMZP0.norm_fourShiftSmoothedAverage_sub_le {N : ℕ} (hN : 0 < N) (ℓ : ℕ) (h t : ℤ) (f : ℤ → ℂ)
  (hf : ∀ (k : ℤ), ‖f k‖ ≤ 1) :
  ‖GMZP0.fourShiftSmoothedAverage N ℓ h t f - (∑ k ∈ GMZP0.lagInnerInterval N h t, f k) / ↑N‖ ≤ 8 * ↑ℓ / ↑N
GMZP0.uniform_positive_smoothed_average (κ η : ℝ) (hκ : 0 < κ) (hη : 0 < η) (hη1 : η ≤ 1) :
  ∃ M c a N₀,
    0 < M ∧
      0 < c ∧
        0 < a ∧
          0 < N₀ ∧
            ∀ (N : ℕ),
              N₀ ≤ N →
                ∀ (q : ℕ) [inst : NeZero q],
                  N ^ 2 < q →
                    q ≤ 128 * N ^ 2 →
                      ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ)
                        (μ : GMZP0.Base N → ℝ),
                        GMZP0.Admissible N κ η f θ lam μ →
                          ∃ X D b,
                            D = X ×ˢ GMZP0.safeRows N (N / M) ∧
                              (∀ (x : Fin N), x ∈ X ↔ b ≤ ↑x ∧ ↑x ≤ b + N / M) ∧
                                c ≤ ∑ z ∈ D, μ z ∧
                                  (∀ x ∈ X, ∀ x' ∈ X, |↑↑x' - ↑↑x| ≤ ↑(N / M)) ∧
                                    (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                      η * ∑ z ∈ D, μ z ≤
                                          ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D)
                                              lam‖ ∧
                                        a ≤ GMZP0.cyclicModulusAverage N q θ X (GMZP0.originalScaledWeight N μ D) lam ∧
                                          7 * a / 8 ≤
                                              GMZP0.cyclicSmoothedModulusAverage N q (GMZP0.smoothingRadius N a) θ X
                                                (GMZP0.originalScaledWeight N μ D) lam ∧
                                            ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.cyclicSmoothedLagB_four_faces (N q ℓ : ℕ) (p : GMZP0.Base N → GMZP0.Frequency) (σ : GMZP0.Base N → ℝ)
  (lam : GMZP0.Base N → ℂ) (x : Fin N) (v : ZMod q) (h t : ℤ) :
  GMZP0.cyclicSmoothedLagB N q ℓ p σ lam x v h t =
    (∑ k ∈ GMZP0.lagInnerInterval N h t,
        GMZP0.complexUniformMean fun u =>
          GMZP0.cyclicLagG N q p σ lam x v h t (k + GMZP0.fourShiftSum ℓ u) *
            ∏ i,
              GMZP0.cubicFacePhase t k
                (GMZP0.originalFieldExtension N p 0 (↑↑x + 1 + h, ↑(v + ↑(h ^ 2 + 2 * h * t)).val)) (fun j => ↑(u j))
                i) /
      ↑N
GMZP0.box_cauchy_schwarz.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] (n : ℕ) (F : (Fin (n + 1) → A) → ℂ)
  (b : Fin (n + 1) → (Fin (n + 1) → A) → ℂ) :
  (∀ (i : Fin (n + 1)) (u : Fin (n + 1) → A), ‖b i u‖ = 1) →
    (∀ (i : Fin (n + 1)), GMZP0.FaceIndependent (b i) i) →
      ‖GMZP0.boxCorrelation F b‖ ^ 2 ^ (n + 1) ≤ GMZP0.boxMoment n F
GMZP0.boxNorm_pow.{u_1} {A : Type u_1} [Fintype A] (n : ℕ) (F : (Fin (n + 1) → A) → ℂ) :
  GMZP0.boxNorm n F ^ 2 ^ (n + 1) = GMZP0.boxMoment n F
GMZP0.cyclicSmoothedLagB_le_boxSum {N : ℕ} (hN : 0 < N) (q ℓ : ℕ) (p : GMZP0.Base N → GMZP0.Frequency)
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) (x : Fin N) (v : ZMod q) (h t : ℤ) :
  ‖GMZP0.cyclicSmoothedLagB N q ℓ p σ lam x v h t‖ ≤
    (∑ k ∈ GMZP0.lagInnerInterval N h t, GMZP0.cyclicLagBoxNorm N q ℓ p σ lam x v h t k) / ↑N
GMZP0.cyclicBoxNormAverage_pow_le {N : ℕ} (hN : 0 < N) (q ℓ : ℕ) [NeZero q] (p : GMZP0.Base N → GMZP0.Frequency)
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) :
  GMZP0.cyclicBoxNormAverage N q ℓ p σ lam ^ 16 ≤ GMZP0.cyclicBoxMomentAverage N q ℓ p σ lam
GMZP0.uniform_positive_box_average (κ η : ℝ) (hκ : 0 < κ) (hη : 0 < η) (hη1 : η ≤ 1) :
  ∃ M c a N₀,
    0 < M ∧
      0 < c ∧
        0 < a ∧
          0 < N₀ ∧
            ∀ (N : ℕ),
              N₀ ≤ N →
                ∀ (q : ℕ) [inst : NeZero q],
                  N ^ 2 < q →
                    q ≤ 128 * N ^ 2 →
                      ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ)
                        (μ : GMZP0.Base N → ℝ),
                        GMZP0.Admissible N κ η f θ lam μ →
                          ∃ X D b,
                            D = X ×ˢ GMZP0.safeRows N (N / M) ∧
                              (∀ (x : Fin N), x ∈ X ↔ b ≤ ↑x ∧ ↑x ≤ b + N / M) ∧
                                c ≤ ∑ z ∈ D, μ z ∧
                                  (∀ x ∈ X, ∀ x' ∈ X, |↑↑x' - ↑↑x| ≤ ↑(N / M)) ∧
                                    (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                      η * ∑ z ∈ D, μ z ≤
                                          ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D)
                                              lam‖ ∧
                                        (a / 4) ^ 16 ≤
                                            GMZP0.cyclicBoxMomentAverage N q (GMZP0.smoothingRadius N a) θ
                                              (GMZP0.originalScaledWeight N μ D) lam ∧
                                          ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.cubeMean_eq_boxMoment.{u_1} {A : Type u_1} [Fintype A] (n : ℕ) (F : (Fin (n + 1) → A) → ℂ) :
  GMZP0.cubeMean (n + 1) F = ↑(GMZP0.boxMoment n F)
GMZP0.cyclicRerootedCubeAverage_eq_moment (N q ℓ : ℕ) [NeZero q] (p : GMZP0.Base N → GMZP0.Frequency)
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) :
  GMZP0.cyclicRerootedCubeAverage N q ℓ p σ lam = ↑(GMZP0.cyclicBoxMomentAverage N q ℓ p σ lam)
GMZP0.cyclicCubePhase_polynomial (N q ℓ : ℕ) (p : GMZP0.Base N → GMZP0.Frequency) (x : Fin N) (Y : ZMod q) (h k t : ℤ)
  (u : GMZP0.CubeShiftPairs ℓ) :
  GMZP0.cyclicCubePhase N q ℓ p x Y h k u t =
    t ^ 3 • GMZP0.cyclicCubeCoefficients N q ℓ p x Y h k u 3 +
          t ^ 2 • GMZP0.cyclicCubeCoefficients N q ℓ p x Y h k u 2 +
        t • GMZP0.cyclicCubeCoefficients N q ℓ p x Y h k u 1 +
      GMZP0.cyclicCubeCoefficients N q ℓ p x Y h k u 0
GMZP0.cyclicRerootedCubeAverage_split_time (N q ℓ : ℕ) [NeZero q] (p : GMZP0.Base N → GMZP0.Frequency)
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) :
  GMZP0.cyclicRerootedCubeAverage N q ℓ p σ lam =
    GMZP0.complexUniformMean fun z =>
      ↑(GMZP0.cyclicCubeWeight N q ℓ σ z.1 z.2.2.1 (↑z.2.1) z.2.2.2.2) *
          GMZP0.cyclicCubeAlignment N q ℓ lam z.1 z.2.2.1 (↑z.2.1) z.2.2.2.2 *
        GMZP0.cyclicCubeTimeAverage N q ℓ p z.1 z.2.2.1 (↑z.2.1) (↑z.2.2.2.1) z.2.2.2.2
GMZP0.cyclicCube_original_vertices {N q : ℕ} [NeZero q] (hq : N ^ 2 < q) (ℓ : ℕ) (f : ℤ × ℤ → ℂ)
  (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ) (μ : GMZP0.Base N → ℝ) (D : Finset (GMZP0.Base N))
  (η : ℝ) (hresponse : ∀ (z : GMZP0.Base N), μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re) (x : Fin N)
  (Y : ZMod q) (h : ℤ) (u : GMZP0.CubeShiftPairs ℓ)
  (hW : GMZP0.cyclicCubeWeight N q ℓ (GMZP0.originalScaledWeight N μ D) x Y h u ≠ 0) (ω : Fin 4 → Bool) :
  ∃ y,
    GMZP0.cyclicCubeVertex q ℓ h Y u ω = GMZP0.cyclicRow N q y ∧
      (x, y) ∈ D ∧
        μ (x, y) ≠ 0 ∧
          GMZP0.cyclicField N q θ 0 x (GMZP0.cyclicCubeVertex q ℓ h Y u ω) = θ (x, y) ∧
            GMZP0.cyclicField N q lam 1 x (GMZP0.cyclicCubeVertex q ℓ h Y u ω) = lam (x, y) ∧
              GMZP0.cyclicField N q (GMZP0.originalScaledWeight N μ D) 0 x (GMZP0.cyclicCubeVertex q ℓ h Y u ω) =
                  ↑N ^ 3 * μ (x, y) ∧
