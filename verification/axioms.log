                              (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                η * ∑ z ∈ D, μ z ≤
                                    ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D) lam‖ ∧
                                  2 * ζ ≤ GMZP0.lagSignedDoubleStatistic N θ X (GMZP0.originalScaledWeight N μ D) lam ∧
                                    ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.signed_plus_diagonal_reroot {N : ℕ} (hN : 0 < N) (p : GMZP0.Base N → GMZP0.Frequency) (X : Finset (Fin N))
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) :
  GMZP0.lagSignedDoubleStatistic N p X σ lam + GMZP0.lagDiagonalStatistic N p X σ lam =
    GMZP0.rerootedWeightedSum N p X σ lam / ↑N ^ 5
