GMZP0.FiniteMinorEstimate (Q N : ℕ) (s : ℝ) (p : GMZP0.Base N → GMZP0.Frequency) : Prop
GMZP0.finite_capture_from_model_operators (Q : ℕ) (hQ : 1 ≤ Q) (ε : ℝ) (hε : 0 < ε) :
  ∃ L,
    1 ≤ L ∧
      ∀ (N : ℕ),
        1 ≤ N →
          ∃ β,
            ∀ (J : ℕ),
              1 ≤ J →
                ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (p : Fin J → GMZP0.Base N → GMZP0.Frequency)
                  (ι : GMZP0.Base N → Fin J) (lam : GMZP0.Base N → ℂ) (μ : GMZP0.Base N → ℝ) (A : Finset (GMZP0.Base N))
                  (η c : ℝ),
                  (∀ (w : ℤ × ℤ), ‖f w‖ ≤ 1) →
                    0 < η →
                      ε ≤ η →
                        0 ≤ c →
                          (∀ z ∈ A, 0 ≤ μ z ∧ μ z ≤ (↑N)⁻¹ ^ 3) →
                            c ≤ ∑ z ∈ A, μ z →
                              (∀ z ∈ A, ‖lam z‖ = 1) →
                                (∀ z ∈ A, η ≤ (lam z * GMZP0.response N f z (θ z)).re) →
                                  (∀ z ∈ A, GMZP0.cubicDistance N (θ z) (p (ι z) z) ≤ ε / 2) →
                                    (∀ (i : Fin J), GMZP0.FiniteMinorEstimate Q N (η * √c / (8 * √↑J)) (p i)) →
                                      ∃ A' j,
                                        A' ⊆ A ∧
                                          c / 2 ≤ ∑ z ∈ A', μ z ∧ ∀ z ∈ A', GMZP0.cubicDistance N (θ z) (β (j z)) ≤ ε
GMZP0.original_window_first_tt {N : ℕ} (hN : 0 < N) (f : ℤ × ℤ → ℂ) (hf : ∀ (v : ℤ × ℤ), ‖f v‖ ≤ 1)
  (p : GMZP0.Base N → GMZP0.Frequency) (μ : GMZP0.Base N → ℝ) (D : Finset (GMZP0.Base N)) (lam : GMZP0.Base N → ℂ)
  (hlam : ∀ (z : GMZP0.Base N), ‖lam z‖ = 1) (hμ : ∀ (z : GMZP0.Base N), 0 ≤ μ z ∧ μ z ≤ (↑N)⁻¹ ^ 3) :
  ↑N ^ 3 *
      max (‖GMZP0.weightedOriginalResponse N f p (GMZP0.originalScaledWeight N μ D) lam‖ ^ 2 / 4 - (∑ z ∈ D, μ z) / ↑N)
        0 ≤
    GMZP0.offBlockNormSum N p (GMZP0.alignedWeightVector (GMZP0.originalScaledWeight N μ D) lam)
GMZP0.original_window_finite_signed_lower {N : ℕ} (hN : 0 < N) (f : ℤ × ℤ → ℂ) (hf : ∀ (v : ℤ × ℤ), ‖f v‖ ≤ 1)
  (p : GMZP0.Base N → GMZP0.Frequency) (μ : GMZP0.Base N → ℝ) (D : Finset (GMZP0.Base N)) (X : Finset (Fin N))
  (hD : ∀ z ∈ D, z.1 ∈ X) (lam : GMZP0.Base N → ℂ) (hlam : ∀ (z : GMZP0.Base N), ‖lam z‖ = 1)
  (hμ : ∀ (z : GMZP0.Base N), 0 ≤ μ z ∧ μ z ≤ (↑N)⁻¹ ^ 3) :
  max (‖GMZP0.weightedOriginalResponse N f p (GMZP0.originalScaledWeight N μ D) lam‖ ^ 2 / 4 - (∑ z ∈ D, μ z) / ↑N) 0 ^
      2 ≤
    GMZP0.finiteSignedDoubleStatistic N p X (GMZP0.alignedWeightVector (GMZP0.originalScaledWeight N μ D) lam) +
      (∑ z ∈ D, μ z) / ↑N
GMZP0.uniform_positive_safe_statistic (κ η : ℝ) (hκ : 0 < κ) (hη : 0 < η) (hη1 : η ≤ 1) :
  ∃ M c ζ N₀,
    0 < M ∧
      0 < c ∧
        0 < ζ ∧
          0 < N₀ ∧
            ∀ (N : ℕ),
              N₀ ≤ N →
                ∀ (f : ℤ × ℤ → ℂ) (θ : GMZP0.Base N → GMZP0.Frequency) (lam : GMZP0.Base N → ℂ) (μ : GMZP0.Base N → ℝ),
                  GMZP0.Admissible N κ η f θ lam μ →
                    ∃ X D a,
                      D = X ×ˢ GMZP0.safeRows N (N / M) ∧
                        (∀ (x : Fin N), x ∈ X ↔ a ≤ ↑x ∧ ↑x ≤ a + N / M) ∧
                          c ≤ ∑ z ∈ D, μ z ∧
                            (∀ x ∈ X, ∀ x' ∈ X, |↑↑x' - ↑↑x| ≤ ↑(N / M)) ∧
                              (∀ z ∈ D, GMZP0.SafeVertical (↑N) (↑(N / M)) (GMZP0.basePoint z).2) ∧
                                η * ∑ z ∈ D, μ z ≤
                                    ‖GMZP0.weightedOriginalResponse N f θ (GMZP0.originalScaledWeight N μ D) lam‖ ∧
                                  2 * ζ ≤
                                      GMZP0.finiteSignedDoubleStatistic N θ X
                                        (GMZP0.alignedWeightVector (GMZP0.originalScaledWeight N μ D) lam) ∧
                                    ∀ z ∈ D, μ z ≠ 0 → η ≤ (lam z * GMZP0.response N f z (θ z)).re
GMZP0.finiteSignedDoubleStatistic_eq_lag {N : ℕ} (H : ℕ) (p : GMZP0.Base N → GMZP0.Frequency) (X : Finset (Fin N))
  (σ : GMZP0.Base N → ℝ) (lam : GMZP0.Base N → ℂ) (hHN : H ≤ N)
  (hX : ∀ x ∈ X, ∀ x' ∈ X, |GMZP0.horizontalGap x x'| ≤ ↑H)
  (hσ : ∀ (x : Fin N) (y : Fin (N ^ 2)), σ (x, y) ≠ 0 → GMZP0.SafeVertical (↑N) (↑H) (↑↑y + 1)) :
  GMZP0.finiteSignedDoubleStatistic N p X (GMZP0.alignedWeightVector σ lam) = GMZP0.lagSignedDoubleStatistic N p X σ lam
