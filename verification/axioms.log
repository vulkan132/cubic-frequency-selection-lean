  (m : GMZP0.Base N → ℂ) (hm : ∀ (z : GMZP0.Base N), ‖m z‖ ≤ 1) (ε : ℝ) (hε : 0 ≤ ε)
  (hclose : ∀ (z : GMZP0.Base N), m z ≠ 0 → ‖p z - q z‖ ≤ ε / (2 * Real.pi * ↑N ^ 3)) (g : GMZP0.InputBox N → ℂ) :
